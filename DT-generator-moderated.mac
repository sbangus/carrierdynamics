# D-T generator neutron source: 14.1 MeV neutrons on the Al bud box + detector,
# with a three-layer moderator stack between the source and the box.
#
# Geometry along +Z (primary travel toward -Z / detector):
#   neutron GPS (z = 393.5 mm, +Z of Fe) ->
#   Fe moderator (378.5-393.5 mm) ->
#   gamma GPS (z = 378.5 mm, -Z face of Fe) ->
#   air (12.5-378.5 mm) -> Al box (+Z face at 12.5 mm) -> detector.
#
# Moderator stack (layer 1 adjacent to the box +Z face; higher indices toward
# the source):
#   layer 1 : G4_AIR  366 mm
#   layer 2 : G4_Fe    15 mm  -- outermost layer toward the neutron source
#
# Neutron source: on the +Z exterior face of the Fe layer.
#   z = boxHalfZ (12.5 mm) + sourceStandoff (381 mm) = 393.5 mm
#
# Gamma source: on the -Z face of Fe (detector side of the steel slab).
#   z = 12.5 mm + air layer thickness (366 mm) = 378.5 mm
#
# Source 1: 14.1 MeV D-T neutrons, collimated along -Z, Gaussian spread.
# Source 2: x-ray / gamma, Arb 20-130 keV (peak ~65 keV), cos toward -Z.
#   Mixed dual-source: I_neutron=1.0, I_gamma=12.5, N_n0=40e6, beamOn=540e6
#
/control/verbose 1
/run/verbose 1
#
/testhadr/det/setNbOfLayers 1
/testhadr/det/setNbOfAbsor 4
/testhadr/det/setAbsor 1 G4_Ag        40 nm
/testhadr/det/setAbsor 2 PNDI-T10     10 um
/testhadr/det/setAbsor 3 ITO         100 nm
/testhadr/det/setAbsor 4 QuartzGlass 1 mm
/testhadr/det/setSizeY 8.5 mm
/testhadr/det/setSizeZ 11.5 mm
#
/testhadr/det/setBoxExternal 103 53 25 mm
/testhadr/det/setBoxWallThickness 1.8 mm
/testhadr/det/setDetectorStandoff 3 mm
/testhadr/det/setBoxMaterial G4_Al
/testhadr/det/setCavityMaterial G4_AIR
/testhadr/det/setWorldMaterial G4_AIR
/testhadr/det/setLabSize 2000 2000 2000 mm
#
/testhadr/det/setBackSlabEnable false
#
# Two-layer moderator: air gap, Fe at the source (+Z) side.
/testhadr/det/setNbOfModeratorLayers 2
#/testhadr/det/setModeratorLayer 1 G4_Pb 50.8 mm
#/testhadr/det/setModeratorLayer 2 G4_AIR 315.2 mm
/testhadr/det/setModeratorLayer 1 G4_AIR 366 mm
/testhadr/det/setModeratorLayer 2 G4_Fe 15 mm
/testhadr/det/setModeratorEnable true
/testhadr/det/setModeratorTransverse 200 200 mm
/testhadr/det/setModeratorGap 0 mm
# 15 in from the Al box front (+Z) face; equals Pb + air + steel = 381 mm.
/testhadr/det/setSourceStandoff 381 mm
#
/random/setSeeds 141001 141002
/run/initialize
#
/analysis/setFileName DT-generator-moderated
#
# --- Source 1: D-T neutrons (intensity 1.0) ---
/gps/source/intensity 1.0
/gps/particle neutron
#
# ----------------------------
# Position distribution
# Planar source on the +Z face: 200 x 200 mm rectangle.
# Centre z = box half-depth (12.5 mm) + sourceStandoff (381 mm) = 393.5 mm.
# ----------------------------
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/halfx 100 mm
/gps/pos/halfy 100 mm
/gps/pos/centre 0 0 393.5 mm
#
# Collimated beam along -Z (toward detector).
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 0 deg
#
# ----------------------------
# Energy distribution
# Gaussian approximation around 14.1 MeV
# If 0.375 MeV is treated as FWHM:
# sigma = 0.375 / 2.355 = 0.159 MeV
# ----------------------------
/gps/ene/type Gauss
/gps/ene/mono 14.1 MeV
/gps/ene/sigma 0.16 MeV
#
# --- Source 2: x-ray / gamma (intensity 12.5) ---
/gps/source/add 12.5
/gps/particle gamma
/gps/ene/type Arb
/gps/hist/type arb
/gps/hist/point 0.020 0.05
/gps/hist/point 0.040 0.55
/gps/hist/point 0.060 0.95
/gps/hist/point 0.065 1.00
/gps/hist/point 0.070 0.98
/gps/hist/point 0.090 0.60
/gps/hist/point 0.110 0.35
/gps/hist/point 0.130 0.12
/gps/hist/inter Lin
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/halfx 100 mm
/gps/pos/halfy 100 mm
/gps/pos/centre 0 0 378.5 mm
/gps/ang/type cos
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 90 deg
#
/run/printProgress 1000000
/run/beamOn 540000000
