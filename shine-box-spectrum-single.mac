#
# Bare calorimeter stack in air: no aluminum bud box (spectrum already includes
# transport through box + environment), lab/world is air only (no water).
#
# Neutron energy: Arb histogram from ASCII (MeV, weight), e.g. hist 321 export.
#
# GPS: planar source on the +Z side at the thin front-face monitor mid-plane —
# i.e. immediately upstream of absorber 1 (same 1 nm gap + 0.5 um slab as in
# DetectorConstruction when wall thickness is 0).
#
# Encasement and moderator OFF.
#
# GPS file: MeV + weight, no comments (.txt energies are eV; divide by 1e6):
#   awk '!/^#/ && NF>=2 {printf "%.17g %.17g\n", $1/1e6, $2}' neutron_frontface_gps.txt > neutron_frontface_gps.dat
# Run Hadr05 from the directory containing neutron_frontface_gps.dat (build/).
#
/control/verbose 1
/run/verbose 1
#
/testhadr/det/setNbOfLayers 1
/testhadr/det/setNbOfAbsor 4
/testhadr/det/setAbsor 1 G4_Ag        40 nm
/testhadr/det/setAbsor 2 PNDI-T10     75 um
/testhadr/det/setAbsor 3 ITO         100 nm
/testhadr/det/setAbsor 4 QuartzGlass 100 um
/testhadr/det/setSizeYZ 15 mm
#
# No bud box: calorimeter sits in world; front Z = half total absorber depth.
/testhadr/det/setBoxWallThickness 0 mm
/testhadr/det/setCavityMaterial G4_AIR
/testhadr/det/setWorldMaterial G4_AIR
/testhadr/det/setLabSize 2000 2000 2000 mm
#
/testhadr/det/setEncasementEnable false
/testhadr/det/setModeratorEnable false
#
/run/initialize
#
/gps/particle neutron
/gps/ene/type Arb
/gps/hist/type arb
/gps/hist/file neutron_frontface_gps.dat
/gps/hist/inter Lin
#
# Plane matches calorimeter transverse size (15 mm full -> 7.5 mm half-edge).
# z = frontZ + 1 nm + 0.25 um with frontZ = (40 nm + 75 um + 100 nm + 100 um) / 2
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/halfx 7.5 mm
/gps/pos/halfy 7.5 mm
/gps/pos/centre 0 0 0.1 mm
#
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 0 deg
#
/random/setSeeds 123556280 917154313
/run/printProgress 10000
/run/beamOn 50000