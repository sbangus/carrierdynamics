# Same geometry and source as shine-dd-box.mac, with visualization and no /run/beamOn.
# Interactive: ./Hadr05 then /control/execute shine-dd-box-vis.mac then /run/beamOn 100000
#
/control/verbose 1
/run/verbose 1
#
/testhadr/det/setNbOfLayers 1
/testhadr/det/setNbOfAbsor 4
/testhadr/det/setAbsor 1 G4_Ag        40 nm
/testhadr/det/setAbsor 2 PNDI-T10     75 um
/testhadr/det/setAbsor 3 ITO         100 nm
/testhadr/det/setAbsor 4 QuartzGlass 100 um
/testhadr/det/setSizeYZ 15 mm
#
/testhadr/det/setBoxExternal 103 53 25 mm
/testhadr/det/setBoxWallThickness 1.8 mm
/testhadr/det/setDetectorStandoff 10 mm
/testhadr/det/setBoxMaterial G4_Al
/testhadr/det/setCavityMaterial G4_AIR
/testhadr/det/setWorldMaterial G4_WATER
/testhadr/det/setLabSize 2000 2000 2000 mm
#
/testhadr/det/setEncasementEnable true
/testhadr/det/setEncasementOuter 336.3 336.3 183.39 mm
/testhadr/det/setEncasementWallThickness 4.6 mm
#
/testhadr/det/setModeratorGap 0 mm
/testhadr/det/setSourceStandoff 7.62 mm
/testhadr/det/setModeratorEnable false
/testhadr/det/setModeratorMaterial ABS
#
/run/numberOfThreads 1
/run/initialize
#
/gps/particle neutron
/gps/ene/type Mono
/gps/ene/mono 2.45 MeV
#
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/halfx 25.75 mm
/gps/pos/halfy 13.25 mm
#/gps/pos/centre 0 0 24.72 mm
#/gps/pos/centre 0 0 12.5 mm
/gps/pos/centre 0 0 17.1 mm
#
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 60 deg
#
/run/printProgress 10000
#
/vis/open
/vis/viewer/set/autoRefresh false
/vis/verbose errors
/vis/drawVolume
/vis/geometry/set/visibility World 0 false
/vis/geometry/set/visibility world 0 false
/vis/viewer/set/style wireframe
/vis/viewer/set/viewpointThetaPhi 65 35 deg
/vis/viewer/zoom 2.0
/vis/scene/add/axes 0 0 0 20 mm
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set neutron cyan
/vis/modeling/trajectories/drawByParticleID-0/set proton red
/vis/modeling/trajectories/drawByParticleID-0/set gamma yellow
/vis/modeling/trajectories/drawByParticleID-0/set e- green
/vis/modeling/trajectories/drawByParticleID-0/set e+ magenta
/vis/modeling/trajectories/drawByParticleID-0/set alpha orange
/tracking/storeTrajectory 1
/vis/scene/endOfEventAction accumulate
/vis/viewer/set/autoRefresh true
/vis/verbose warnings
