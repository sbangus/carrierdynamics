# Three-layer moderator stack between the GPS and the bud box (layer 1 on the
# aluminum +Z face, higher indices toward +Z / source):
#   lead (5 mm) -> heavy water (85 mm) -> polyethylene (95 mm).
# Along -Z toward the detector: ... polyethylene -> D2O -> Pb -> Al shell ->
# cavity -> detector.
#
# Geometry along +Z (neutron drift toward -Z): GPS in air -> 10 mm gap ->
# polyethylene (95 mm) -> HeavyWater (85 mm) -> G4_Pb (5 mm) -> aluminum
# shell -> air cavity -> detector.
#
# Default world material is G4_AIR; setWorldMaterial below is optional.
# sourceStandoff must be >= sum(layer thicknesses) + moderatorGap = 195 mm.
#
/control/verbose 1
/run/verbose 1
#
/testhadr/det/setNbOfLayers 1
/testhadr/det/setNbOfAbsor 4
/testhadr/det/setAbsor 1 G4_Ag        40 nm
/testhadr/det/setAbsor 2 PNDI-T10-B4C     30 um
/testhadr/det/setAbsor 3 ITO         100 nm
/testhadr/det/setAbsor 4 QuartzGlass 100 um
/testhadr/det/setSizeY 8 mm
/testhadr/det/setSizeZ 11 mm
#
/testhadr/det/setBoxExternal 103 53 25 mm
/testhadr/det/setBoxWallThickness 1.8 mm
/testhadr/det/setDetectorStandoff 10 mm
/testhadr/det/setBoxMaterial G4_Al
/testhadr/det/setCavityMaterial G4_AIR
/testhadr/det/setWorldMaterial G4_AIR
/testhadr/det/setLabSize 2000 2000 2000 mm
#
/testhadr/det/setNbOfModeratorLayers 3
/testhadr/det/setModeratorLayer 1 G4_Pb 0.01 mm
/testhadr/det/setModeratorLayer 2 HeavyWater 95 mm
/testhadr/det/setModeratorLayer 3 polyethylene 75 mm
/testhadr/det/setModeratorGap 10 mm
# Lateral moderator footprint (full X x Y). Independent of bud-box externals.
# Use "0 0 mm" to revert to box size (103 x 53 mm). Scale per macro as needed.
/testhadr/det/setModeratorTransverse 200 200 mm
/testhadr/det/setSourceStandoff 183 mm
#
#/testhadr/det/setNbOfModeratorLayers 2
#/testhadr/det/setModeratorLayer 1 HeavyWater 85 mm
#/testhadr/det/setModeratorLayer 2 polyethylene 105 mm
#/testhadr/det/setModeratorGap 10 mm
#/testhadr/det/setSourceStandoff 200 mm
/random/setSeeds 121737800 913654137
/run/initialize

/analysis/setFileName DD-moderated-shielding

#
#/gps/particle neutron
#/gps/ene/type Mono
#/gps/ene/mono 2.45 MeV
#/gps/ene/mono 600 keV
#
# Planar source on the +Z face: rectangle matches moderator transverse (500 x 500 mm).
# Centre z = box half-depth (12.5 mm) + sourceStandoff (200 mm).
#/gps/pos/type Plane
#/gps/pos/shape Rectangle
#/gps/pos/halfx 20 mm
#/gps/pos/halfy 10 mm
#/gps/pos/centre 0 0 212.5 mm
#
# Collimated beam along -Z (toward detector). GPS "iso" emits along -AngRef3
# (AngRef3 = rot1 x rot2); rot1 = +X, rot2 = +Y => theta = 0 is -Z.
# Do not use beam1d with rot1 = (0,0,-1): that sets x' = -Z and theta = 0
# fires along +X, parallel to the detector face.
#/gps/ang/type iso
#/gps/ang/rot1 1 0 0
#/gps/ang/rot2 0 1 0
#/gps/ang/mintheta 0 deg
#/gps/ang/maxtheta 0 deg
#


# --- Source 1: 2.45 MeV DD neutrons (intensity 1.0) ---
/gps/source/intensity 1.0
/gps/particle neutron
/gps/ene/type Mono
/gps/ene/mono 2.45 MeV
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/halfx 50 mm
/gps/pos/halfy 50 mm
/gps/pos/centre 0 0 212.5 mm
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 0 deg
# --- Source 2: thermal neutrons (intensity 1.0) ---
/gps/source/add 1.0
/gps/particle neutron
/gps/ene/type Mono
/gps/ene/mono 0.025 eV
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/halfx 50 mm
/gps/pos/halfy 50 mm
/gps/pos/centre 0 0 212.5 mm
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 0 deg
/run/printProgress 100000
/run/beamOn 5000000
