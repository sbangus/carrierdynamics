# PUR-1 homogenized U-235 prompt-fission source.
#
# The energy distribution is the ENDF/B-VII.1 thermal-U-235 Watt spectrum
# tabulated in u235_fission_source.mac (a = 0.988 MeV, b = 2.249 1/MeV).
# This source emits prompt neutrons only, isotropically.
#
# The source is a 20 x 50 x 20 cm box.  The 50 cm dimension is mapped to
# global Y so the detector at x=y=0 is halfway down and laterally centered on
# the source.  Global Z is the source-to-detector axis.  The source center at
# z=412.5 mm puts its -Z face at z=312.5 mm, exactly 300 mm of water from the
# aluminum box +Z face at z=12.5 mm.
#
# This is the homogenized-core approximation: no fuel geometry is present and
# /gps/pos/confine is deliberately not used.  Neutrons are born in the water
# world throughout the nominal core envelope.

/gps/verbose 0
/gps/particle neutron

/gps/ang/type iso
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 180 deg
/gps/ang/minphi 0 deg
/gps/ang/maxphi 360 deg

/gps/pos/type Volume
/gps/pos/shape Para
/gps/pos/centre 0 0 412.5 mm
/gps/pos/halfx 10 cm
/gps/pos/halfy 25 cm
/gps/pos/halfz 10 cm
/gps/pos/confine NULL

/gps/ene/type Arb
/gps/hist/type arb
/gps/hist/point 1e-05      5.979155e-03
/gps/hist/point 5e-05      1.336946e-02
/gps/hist/point 0.0001     1.890666e-02
/gps/hist/point 0.00025    2.989120e-02
