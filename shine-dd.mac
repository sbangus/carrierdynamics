# SHINE-style DD layout: planar neutron source flush against a 0.3 inch ABS
# slab (103 x 53 mm^2, same as the bud box +Z face), then the aluminum bud box
# and detector stack. World is water (immersion). Neutrons drift toward -Z.
#
# With standoff = 7.62 mm (0.3 inch) and gap = 0, the ABS slab is 0.3 inch thick.
#
/control/verbose 1
/run/verbose 1
#
/testhadr/det/setNbOfLayers 1
/testhadr/det/setNbOfAbsor 4
/testhadr/det/setAbsor 1 G4_Ag        40 nm
/testhadr/det/setAbsor 2 PNDI-T10     75 um
/testhadr/det/setAbsor 3 ITO         100 nm
/testhadr/det/setAbsor 4 QuartzGlass 100 um
/testhadr/det/setSizeYZ 15 mm
#
/testhadr/det/setBoxExternal 103 53 25 mm
/testhadr/det/setBoxWallThickness 1.8 mm
/testhadr/det/setDetectorStandoff 10 mm
/testhadr/det/setBoxMaterial G4_Al
/testhadr/det/setCavityMaterial G4_AIR
/testhadr/det/setWorldMaterial G4_WATER
/testhadr/det/setLabSize 2000 2000 2000 mm
#
# Slab thickness along +Z = sourceStandoff - moderatorGap (0.3 inch = 7.62 mm).
/testhadr/det/setModeratorGap 0 mm
/testhadr/det/setSourceStandoff 7.62 mm
/testhadr/det/setModeratorEnable true
/testhadr/det/setModeratorMaterial ABS
#
/run/initialize
#
/gps/particle neutron
/gps/ene/type Mono
/gps/ene/mono 2.45 MeV
#
# Planar source on the +Z side of the stack: rectangle 103 x 53 mm (half sizes).
# Centre z must match half the bud box outer half-depth (25/2 mm) + standoff.
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/halfx 25.75 mm
/gps/pos/halfy 13.25 mm
/gps/pos/centre 0 0 20.12 mm
#/gps/pos/centre 0 0 12.5 mm
#
# Hemisphere of directions toward the detector (-Z); ref axes match dd macros.
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 60 deg
#
/random/setSeeds 123456789 987654321
/run/printProgress 10000
/run/beamOn 100000
