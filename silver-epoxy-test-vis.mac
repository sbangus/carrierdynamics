# Silver-epoxy contact layer as absorber 1, on top of the pure-Ag film.
# Visualization version of silver-epoxy-test.mac (single-threaded, no trailing
# /run/beamOn so you can drive it interactively).
#
# Interactive workflow:
#   cd build
#   ./Hadr05
#   idle> /control/execute silver-epoxy-test-vis.mac
#   idle> /run/beamOn 20
#
# The silver epoxy (homogenized Ag/C/H/O, rho = 2.34 g/cm3) is modeled as the
# FIRST absorber in the stack (source side), sitting on the 40 nm pure-Ag layer.
# Adding it shifts the downstream indices by one:
#   1 = SilverEpoxy   (this layer)
#   2 = G4_Ag         (40 nm pure-silver film)
#   3 = PNDI-T10      (active polymer, 30 um)
#   4 = ITO           (100 nm)
#   5 = QuartzGlass   (100 nm)
#
# Two geometry options for absorber 1 (pick ONE):
#   (A) Full-area box  : default; epoxy fills the whole absorber-1 slot.
#   (B) Localized blob : /testhadr/det/setSilverEpoxyBlob true; a half-ellipsoid
#       (default base radius 2 mm, height 1 mm) of epoxy embedded in air. The
#       absorber-1 thickness must be >= the blob height, and it sets the depth
#       of the air region that holds the blob.
#
/control/verbose 1
/run/verbose 1
#
/testhadr/det/setNbOfLayers 1
/testhadr/det/setNbOfAbsor 5
/testhadr/det/setAbsor 1 SilverEpoxy   1.2 mm
/testhadr/det/setAbsor 2 G4_Ag        40 nm
/testhadr/det/setAbsor 3 PNDI-T10     0.5 mm
/testhadr/det/setAbsor 4 ITO         100 nm
/testhadr/det/setAbsor 5 QuartzGlass 1 mm
/testhadr/det/setSizeY 8 mm
/testhadr/det/setSizeZ 11 mm
#
# --- Option B: localized half-ellipsoid blob (comment out for full-area box) ---
/testhadr/det/setSilverEpoxyBlob true
/testhadr/det/setSilverEpoxyBlobSize 2 1 mm
#
/testhadr/det/setBoxExternal 103 53 25 mm
/testhadr/det/setBoxWallThickness 1.8 mm
/testhadr/det/setDetectorStandoff 10 mm
/testhadr/det/setBoxMaterial G4_Al
/testhadr/det/setCavityMaterial G4_AIR
/testhadr/det/setWorldMaterial G4_AIR
# Small world for visualization only: the detector stack is ~1 mm, so a 2 m
# world makes the camera framing unusable. 400 mm still contains the bud box
# (103 mm) and the 662 keV source plane at z = 60 mm.
/testhadr/det/setLabSize 400 400 400 mm
#
/run/numberOfThreads 1
/run/initialize
#
/analysis/setFileName silver-epoxy-test-vis
#
# Cs-137-like 662 keV gammas along -Z toward the detector.
/gps/particle gamma
/gps/ene/type Mono
/gps/ene/mono 662 keV
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/halfx 5.5 mm
/gps/pos/halfy 4 mm
/gps/pos/centre 0 0 60 mm
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 0 deg
#
/run/printProgress 100
#
# ---- Visualization ----------------------------------------------------------
/vis/open
/vis/viewer/set/autoRefresh false
/vis/verbose errors
/vis/drawVolume
/vis/geometry/set/visibility World 0 false
/vis/geometry/set/visibility world 0 false
#
# Everything wireframe by default so the thin layers read as edges...
/vis/viewer/set/style wireframe
# ...but render the epoxy blob (logical volume "SilverEpoxy") as a solid,
# coloured dome so it is NOT just a flat projection onto the other absorbers.
/vis/geometry/set/forceSolid SilverEpoxy 0 true
/vis/geometry/set/colour     SilverEpoxy 0 0.85 0.55 0.10 1
# The air slot that holds the blob just adds a box outline; hide it for clarity.
/vis/geometry/set/visibility EpoxyContainer 0 false
#
# View the stack nearly edge-on (theta ~ 80 deg from the stack axis) so the
# half-ellipsoid shows its curved profile instead of projecting as a circle.
#
# Source-direction indicator: the 662 keV source sits on the +Z side and fires
# toward -Z. The epoxy dome should point toward this arrow (toward +Z); the flat
# base rests on the pure-Ag film behind it (toward -Z). If the dome looks like
# it points the other way, you are viewing the stack from the -Z side -- rotate
# the view (e.g. /vis/viewer/set/viewpointThetaPhi 80 200 deg) rather than the geometry.
/vis/open
/vis/viewer/set/autoRefresh false
/vis/verbose errors
/vis/drawVolume
/vis/geometry/set/visibility World 0 false
/vis/geometry/set/visibility world 0 false
/vis/viewer/set/style wireframe
/vis/viewer/set/viewpointThetaPhi 65 35 deg
/vis/viewer/zoom 3.8
/vis/scene/add/axes 0 0 0 20 mm
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set neutron cyan
/vis/modeling/trajectories/drawByParticleID-0/set proton red
/vis/modeling/trajectories/drawByParticleID-0/set gamma yellow
/vis/modeling/trajectories/drawByParticleID-0/set e- green
/vis/modeling/trajectories/drawByParticleID-0/set e+ magenta
/vis/modeling/trajectories/drawByParticleID-0/set alpha orange
/tracking/storeTrajectory 1
/vis/scene/endOfEventAction accumulate
/vis/viewer/set/autoRefresh true
/vis/verbose warnings
# Tips (type at the idle> prompt):
#   /vis/viewer/zoom 1.5              # zoom in/out incrementally
#   /vis/viewer/set/viewpointThetaPhi 90 0 deg   # pure side view (dome profile)
#   /vis/viewer/set/viewpointThetaPhi 60 30 deg  # more 3D / oblique
#   /vis/geometry/set/forceSolid SilverEpoxy 0 false   # back to wireframe blob
#
