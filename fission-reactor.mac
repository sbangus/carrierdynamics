# Reactor-like immersion setup: aluminum bud box surrounded by water in all
# directions (world material is water). The internal cavity remains air.
# Same as dd-reactor.mac except neutron energy: tabulated LEU fission chi(E)
# (n/fission/MeV) vs E (MeV), via GPS Arb histogram (piecewise-linear).
#
# Geometry along +Z (neutron drift toward -Z): GPS in water -> aluminum shell
# -> air cavity -> detector.
#
/control/verbose 1
/run/verbose 1
#
/testhadr/det/setNbOfLayers 1
/testhadr/det/setNbOfAbsor 4
/testhadr/det/setAbsor 1 G4_Ag        40 nm
/testhadr/det/setAbsor 2 PNDI-T10     75 um
/testhadr/det/setAbsor 3 ITO         100 nm
/testhadr/det/setAbsor 4 QuartzGlass 100 um
/testhadr/det/setSizeYZ 15 mm
#
/testhadr/det/setBoxExternal 103 53 25 mm
/testhadr/det/setBoxWallThickness 1.8 mm
/testhadr/det/setDetectorStandoff 10 mm
/testhadr/det/setBoxMaterial G4_Al
/testhadr/det/setCavityMaterial G4_AIR
/testhadr/det/setWorldMaterial G4_WATER
/testhadr/det/setLabSize 2000 2000 2000 mm
/testhadr/det/setSourceStandoff 50 mm
#
# Disable directional +Z-only moderator slab; immersion is provided by world water.
/testhadr/det/setModeratorEnable false
#
/run/initialize
#
/gps/particle neutron
/gps/ene/type Arb
/gps/hist/type arb
/gps/hist/point 0.01 0.068
/gps/hist/point 0.025 0.107
/gps/hist/point 0.05 0.148
/gps/hist/point 0.1 0.203
/gps/hist/point 0.2 0.269
/gps/hist/point 0.5 0.347
/gps/hist/point 1.0 0.347
/gps/hist/point 1.5 0.298
/gps/hist/point 2.0 0.239
/gps/hist/point 2.5 0.184
/gps/hist/point 3.0 0.139
/gps/hist/point 4.0 0.074
/gps/hist/point 5.0 0.038
/gps/hist/point 6.0 0.018
/gps/hist/point 8.0 0.004
/gps/hist/point 10.0 0.0009
/gps/hist/point 12.0 0.
/gps/hist/inter Lin
#
/gps/pos/type Point
/gps/pos/centre 0 0 600 mm
#
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 1.1 deg
#
/run/printProgress 1000
/run/beamOn 100000
