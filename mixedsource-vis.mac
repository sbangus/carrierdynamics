# Same as mixedsource.mac (PNDI-T10-B4C, mixed 4-component planar source),
# with visualization and no /run/beamOn. Run: ./Hadr05 then
# /control/execute mixedsource-vis.mac then /run/beamOn N
#
/control/verbose 1
/run/verbose 1
/random/setSeeds 223757802 977654139
#
/testhadr/det/setNbOfLayers 1
/testhadr/det/setNbOfAbsor 1
/testhadr/det/setAbsor 1 PNDI-T10-B4C 30 um
/testhadr/det/setSizeY 8 mm
/testhadr/det/setSizeZ 11 mm
#
/testhadr/det/setBoxExternal 103 53 25 mm
/testhadr/det/setBoxWallThickness 0 mm
/testhadr/det/setEncasementEnable false
/testhadr/det/setCavityMaterial G4_AIR
/testhadr/det/setWorldMaterial G4_AIR
/testhadr/det/setLabSize 2000 2000 2000 mm
#
/testhadr/det/setNbOfModeratorLayers 0
/testhadr/det/setModeratorEnable false
/testhadr/det/setSourceStandoff 100 mm
#
/run/numberOfThreads 1
/run/initialize
#
/analysis/setFileName mixedsource
#
# Source 1: 2.45 MeV neutrons
/gps/source/intensity 1.0
/gps/particle neutron
/gps/ene/type Mono
/gps/ene/mono 2.45 MeV
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/halfx 7.5 mm
/gps/pos/halfy 7.5 mm
/gps/pos/centre 0 0 112.5 mm
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 0 deg
#
# Source 2: 0.025 eV neutrons
/gps/source/add 1.0
/gps/particle neutron
/gps/ene/type Mono
/gps/ene/mono 0.025 eV
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/halfx 7.5 mm
/gps/pos/halfy 7.5 mm
/gps/pos/centre 0 0 112.5 mm
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 0 deg
#
# Source 3: 2 MeV gammas
/gps/source/add 1.0
/gps/particle gamma
/gps/ene/type Mono
/gps/ene/mono 2 MeV
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/halfx 7.5 mm
/gps/pos/halfy 7.5 mm
/gps/pos/centre 0 0 112.5 mm
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 0 deg
#
# Source 4: 500 keV gammas
/gps/source/add 1.0
/gps/particle gamma
/gps/ene/type Mono
/gps/ene/mono 500 keV
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/halfx 7.5 mm
/gps/pos/halfy 7.5 mm
/gps/pos/centre 0 0 112.5 mm
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 0 deg
#
/run/printProgress 1000
#
/vis/open
/vis/viewer/set/autoRefresh false
/vis/verbose errors
/vis/drawVolume
/vis/geometry/set/visibility World 0 false
/vis/geometry/set/visibility world 0 false
/vis/viewer/set/style wireframe
/vis/viewer/set/viewpointThetaPhi 65 35 deg
/vis/viewer/zoom 2.0
/vis/scene/add/axes 0 0 0 20 mm
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set neutron cyan
/vis/modeling/trajectories/drawByParticleID-0/set proton red
/vis/modeling/trajectories/drawByParticleID-0/set gamma yellow
/vis/modeling/trajectories/drawByParticleID-0/set e- green
/vis/modeling/trajectories/drawByParticleID-0/set e+ magenta
/vis/modeling/trajectories/drawByParticleID-0/set alpha orange
/tracking/storeTrajectory 1
/vis/scene/endOfEventAction accumulate
/vis/viewer/set/autoRefresh true
/vis/verbose warnings
