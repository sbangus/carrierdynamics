# ============================================================================
#  u235_fission_source.mac
#
#  RAW (unmoderated) prompt-fission neutron source for PUR-1.
#  Watt spectrum for thermal-neutron-induced fission of U-235:
#
#      chi(E) = C * exp(-E/a) * sinh( sqrt(b*E) )
#      a = 0.988 MeV,  b = 2.249 1/MeV     (ENDF/B-VII.1, U-235 thermal)
#
#  Verified moments of the tabulation below:
#      <E>  = 2.033 MeV   (analytic a*(1.5 + ab/4) = 2.031 MeV, +0.12%)
#      mode = 0.743 MeV
#      integral error from linear interpolation on this grid: -0.05%
#      fraction above 1 MeV  0.699 | above 2 MeV  0.406 | above 5 MeV  0.056
#
#  NOTE ON ENRICHMENT: 19.75% vs any other enrichment does not change
#  chi(E). The emitted spectrum is a property of the fissioning nuclide,
#  not the fuel composition. Enrichment sets k-eff and the fission rate per
#  unit flux, and at PUR-1's burnup the U-238 fast-fission and Pu-239
#  contributions to the source are together well under 2%, so a pure
#  U-235 thermal Watt spectrum is the right choice.
#
#  This macro emits ONLY first-generation prompt fission neutrons,
#  isotropically, with no moderation, no delayed neutrons and no gammas.
#  Read the NORMALIZATION and the DOUBLE-COUNTING WARNING at the bottom.
#
#  /gps/hist/point energies are in MeV (that command takes no unit string).
# ============================================================================

/gps/verbose 0
/gps/particle neutron


# ----------------------------------------------------------------------------
#  ANGULAR: isotropic. Fission fragments are slow enough that lab-frame
#  anisotropy of the emitted neutrons is negligible.
# ----------------------------------------------------------------------------
/gps/ang/type iso
/gps/ang/mintheta   0. deg
/gps/ang/maxtheta 180. deg
/gps/ang/minphi     0. deg
/gps/ang/maxphi   360. deg


# ----------------------------------------------------------------------------
#  POSITION -- pick ONE of the three blocks below.
# ----------------------------------------------------------------------------

# --- (A) DEFAULT: sample uniformly inside the fuel meat -------------------
#     Sampling box must enclose the whole core; confine rejects anything
#     outside the named PHYSICAL volume. If all your fuel plates share one
#     placement name (replica / parameterised), confine populates them all.
#     Replace fuelMeatPV with your actual physical volume name and set the
#     half-lengths to enclose your core envelope.
/gps/pos/type Volume
/gps/pos/shape Para
/gps/pos/centre 0. 0. 0. cm
/gps/pos/halfx 12. cm
/gps/pos/halfy 12. cm
/gps/pos/halfz 30. cm
/gps/pos/confine fuelMeatPV

# --- (B) point source (single plate, or a far-field check) ----------------
# /gps/pos/type Point
# /gps/pos/centre 0. 0. 0. cm
# /gps/pos/confine NULL

# --- (C) homogenised core box, no confinement ----------------------------
#     Faster than (A) but births neutrons in the water channels too, which
#     softens the leakage spectrum slightly. Fine for far-field work.
# /gps/pos/type Volume
# /gps/pos/shape Para
# /gps/pos/centre 0. 0. 0. cm
# /gps/pos/halfx 10. cm
# /gps/pos/halfy 10. cm
# /gps/pos/halfz 25. cm
# /gps/pos/confine NULL


# ----------------------------------------------------------------------------
#  ENERGY: Watt spectrum, 97-point tabulation, peak normalised to 1.
#          GPS renormalises internally, so absolute scale is irrelevant.
# ----------------------------------------------------------------------------
/gps/ene/type Arb
/gps/hist/type arb
/gps/hist/point 1e-05      5.979155e-03
/gps/hist/point 5e-05      1.336946e-02
/gps/hist/point 0.0001     1.890666e-02
/gps/hist/point 0.00025    2.989120e-02
/gps/hist/point 0.0005     4.226581e-02
/gps/hist/point 0.00075    5.175659e-02
/gps/hist/point 0.001      5.975384e-02
/gps/hist/point 0.0015     7.315989e-02
/gps/hist/point 0.002      8.445084e-02
/gps/hist/point 0.003      1.033648e-01
/gps/hist/point 0.005      1.332734e-01
