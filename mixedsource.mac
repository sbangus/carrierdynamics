# Single PNDI-T10-B4C absorber (30 um along beam, 15 mm x 15 mm transverse).
# Mixed planar source: four mono components with equal intensity (25% each):
#   2.45 MeV neutrons, 0.025 eV neutrons, 2 MeV gammas, 500 keV gammas.
# No moderators; bare calorimeter in air (no aluminum bud box).
# Same bare-detector layout as perpendicular-test.mac.
#
/control/verbose 1
/run/verbose 1
#
/testhadr/det/setNbOfLayers 1
/testhadr/det/setNbOfAbsor 1
/testhadr/det/setAbsor 1 PNDI-T10-B4C 300 um
/testhadr/det/setSizeY 8 mm
/testhadr/det/setSizeZ 11 mm
#
/testhadr/det/setBoxExternal 103 53 25 mm
/testhadr/det/setBoxWallThickness 0 mm
/testhadr/det/setEncasementEnable false
/testhadr/det/setCavityMaterial G4_AIR
/testhadr/det/setWorldMaterial G4_AIR
/testhadr/det/setLabSize 2000 2000 2000 mm
#
/testhadr/det/setNbOfModeratorLayers 0
/testhadr/det/setModeratorEnable false
/testhadr/det/setSourceStandoff 100 mm
#
/random/setSeeds 221757801 817654138
/run/initialize
#
/analysis/setFileName mixedsource
#
# GPS centre z = box half-depth (12.5 mm) + sourceStandoff (100 mm) = 112.5 mm.
# Rectangle matches absorber transverse extent (15 mm x 15 mm).
#
# Source 1: 2.45 MeV neutrons
/gps/source/intensity 1.0
/gps/particle neutron
/gps/ene/type Mono
/gps/ene/mono 2.45 MeV
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/halfx 7.5 mm
/gps/pos/halfy 7.5 mm
/gps/pos/centre 0 0 112.5 mm
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 0 deg
#
# Source 2: 0.025 eV neutrons
/gps/source/add 1.0
/gps/particle neutron
/gps/ene/type Mono
/gps/ene/mono 0.025 eV
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/halfx 7.5 mm
/gps/pos/halfy 7.5 mm
/gps/pos/centre 0 0 112.5 mm
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 0 deg
#
# Source 3: 2 MeV gammas
/gps/source/add 1.0
/gps/particle gamma
/gps/ene/type Mono
/gps/ene/mono 2 MeV
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/halfx 7.5 mm
/gps/pos/halfy 7.5 mm
/gps/pos/centre 0 0 112.5 mm
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 0 deg
#
# Source 4: 500 keV gammas
#/gps/source/add 1.0
#/gps/particle gamma
#/gps/ene/type Mono
#/gps/ene/mono 500 keV
#/gps/pos/type Plane
#/gps/pos/shape Rectangle
#/gps/pos/halfx 7.5 mm
#/gps/pos/halfy 7.5 mm
#/gps/pos/centre 0 0 112.5 mm
#/gps/ang/type iso
#/gps/ang/rot1 1 0 0
#/gps/ang/rot2 0 1 0
#/gps/ang/mintheta 0 deg
#/gps/ang/maxtheta 0 deg
#
/run/printProgress 1000000
/run/beamOn 10000000
